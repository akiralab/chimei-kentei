{
  "name": "chimei-kentei",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "build:og": "node og/render.mjs",
    "build:icons": "node og/render-icons.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:questions": "python3 data/build_questions.py",
    "build:api": "esbuild infra/api/src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=infra/api/dist/handler.mjs --external:@aws-sdk/*",
    "deploy:api": "bash infra/deploy.sh"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1145.0",
    "@aws-sdk/lib-dynamodb": "^3.1145.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
